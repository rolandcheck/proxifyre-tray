<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>proxifyre_tray</RootNamespace>
    <AssemblyName>proxifyre-tray</AssemblyName>
    <ApplicationIcon>Resources\icons8-sorting-arrows-32.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- WFO1000: flags public properties on Form subclasses as needing designer-serialization
         metadata. The properties it targets here exist solely to implement IFormMainView for
         the MVP presenter, not for the WinForms designer, so the warning doesn't apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

</Project>
