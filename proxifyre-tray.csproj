<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>proxifyre_tray</RootNamespace>
    <AssemblyName>proxifyre-tray</AssemblyName>
    <ApplicationIcon>View\Resources\icons8-sorting-arrows-32.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain/Infrastructure/Application/View are their own projects, but their folders sit under
         this one; without this, SDK-style default globbing would also compile their files directly here. -->
    <Compile Remove="Domain\**" />
    <Compile Remove="Infrastructure\**" />
    <Compile Remove="Application\**" />
    <Compile Remove="View\**" />
    <None Remove="Domain\**" />
    <None Remove="Infrastructure\**" />
    <None Remove="Application\**" />
    <None Remove="View\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Application\ProxifyreTray.Application.csproj" />
    <ProjectReference Include="View\ProxifyreTray.View.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local-only, gitignored: a real ProxiFyre.exe (a separate project's binary) and a working
         app-config.json, copied next to the built exe so the app can find them at runtime
         (FormMainPresenter looks for ProxiFyre.exe in AppContext.BaseDirectory). Conditioned on
         actually existing so a fresh clone without them still builds fine. -->
    <None Include="ProxiFyre.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ProxiFyre.exe')" />
    <None Include="app-config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('app-config.json')" />
  </ItemGroup>

</Project>
